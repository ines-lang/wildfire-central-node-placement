# Account credentials for the download steps (copy to the .env file named by THESIS_ENV_FILE, default
# <thesis folder>/master-thesis/.env, and fill in; environment variables of the same name take precedence).
# The offline pipeline (run_all.sh) needs none of them.
SPACETRACK_USERNAME=        # pipeline/2_space_segment/00_fetch_window.py (Space-Track)
SPACETRACK_PASSWORD=
EARTHDATA_USERNAME=         # pipeline/4_events/05_fire_mask_check.py read (NASA Earthdata, Level-2 fire masks)
EARTHDATA_PASSWORD=
CDSE_USERNAME=              # pipeline/1_inputs/slstr/01_download.py (Copernicus Data Space Ecosystem)
CDSE_PASSWORD=
LSASAF_USERNAME=            # pipeline/1_inputs/lsasaf/00_download.py (LSA SAF data server)
LSASAF_PASSWORD=            # optional: prompted when missing
